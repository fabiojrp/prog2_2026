<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cálculo de Média do Estudante</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-body">
                        <h1 class="card-title text-center mb-4">Cálculo de Média do Estudante</h1>
                        
                        <form id="mediaForm" method="POST" action="/calcular">
                            <div class="mb-3">
                                <label class="form-label">Nome do Aluno:</label>
                                <input type="text" class="form-control" name="nome" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Matéria:</label>
                                <input type="text" class="form-control" name="materia" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Nota 1:</label>
                                <input type="number" class="form-control" name="nota1" min="0" max="10" step="0.1" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Nota 2:</label>
                                <input type="number" class="form-control" name="nota2" min="0" max="10" step="0.1" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Nota 3:</label>
                                <input type="number" class="form-control" name="nota3" min="0" max="10" step="0.1" required>
                            </div>

                            <button type="submit" class="btn btn-success w-100">Calcular</button>
                        </form>

                        <div class="alert alert-success mt-4">
                            <% if (nome !== '') { %>
                                O aluno <strong><%= nome %></strong> ficou com a média <strong><%= media %></strong> na disciplina de <strong><%= materia %></strong>.
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>