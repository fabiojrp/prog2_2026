<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <title>Produtos</title>
</head>

<body class="bg-light w-50 mx-auto">
    <div class="container mt-5 p-4 bg-white rounded shadow-sm border border-success">
        <h3>Cadastro de Produtos</h3>
        <form action="/cadastrar" method="post">
            <div class="mb-3">
                <label class="form-label">Nome</label>
                <input type="text" class="form-control" name="nome" required>
            </div>
            <div class="mb-3">
                <label class="form-label">Valor</label>
                <input type="text" class="form-control" name="valor" required>
            </div>
            <div class="mb-3">
                <label class="form-label">Marca</label>
                <input type="text" class="form-control" name="marca" required>
            </div>
            <div class="mb-3">
                <label class="form-label">Modelo</label>
                <input type="text" class="form-control" name="modelo" required>
            </div>
            <button type="submit" class="btn btn-primary">Cadastrar</button>
        </form>

    </div>

    <div class="container mt-5">
        <h3>Produtos Cadastrados</h3>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Valor</th>
                    <th>Marca</th>
                    <th>Modelo</th>
                </tr>
            </thead>
            <tbody>
                <% for(let i=0; i<produtos.length; i++) { %>
                    <tr>
                        <td><%= produtos[i].nome %></td>
                        <td><%= produtos[i].valor %></td>
                        <td><%= produtos[i].marca %></td>
                        <td><%= produtos[i].modelo %></td>
                    </tr>
                <% } %>
            </tbody>
        </table>
        <p class="fw-bold text-end">Soma Total: R$ <%= somaTotal.toFixed(2) %></p>
    </div>
</body>

</html>