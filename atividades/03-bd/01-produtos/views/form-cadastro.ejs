<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Produtos</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
</head>

<body class="bg-light d-flex flex-column min-vh-100">
  <header class="bg-dark text-white py-3 mb-4">
    <div class="container">
      <h1 class="mb-0 text-center">
        <i class="bi bi-cash-coin"></i>
        Site de E-Commerce
      </h1>
    </div>
  </header>

  <main>
    <div class="container py-5 d-flex flex-column align-items-center">
      <h2 class="mb-4">Cadastro de Produtos</h2>
      <form class="row g-3 bg-white p-4 rounded shadow-sm mb-4 w-75" action="/cadastrar" method="POST">
        <div class="col-md-12">
          <label class="form-label">Nome</label>
          <input type="text" name="nome" class="form-control" placeholder="Digite o nome" />
        </div>
        <div class="col-md-6">
          <label class="form-label">Valor</label>
          <input type="text" name="valor" class="form-control" placeholder="0.00" />
        </div>
        <div class="col-md-6">
          <label class="form-label">Quantidade</label>
          <input type="text" name="quantidade" class="form-control" placeholder="0" />
        </div>
        <div class="col-12">
          <button type="submit" class="btn btn-dark w-100 mt-5 mb-3">Salvar</button>
        </div>
      </form>
    </div>
  </main>

  <footer class="bg-dark text-white py-3 mt-4 mt-auto">
    <div class="container text-center">
      &copy; 2026 Produtos. Todos os direitos reservados.
    </div>
  </footer> 
</body>

</html>