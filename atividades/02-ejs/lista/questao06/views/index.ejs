<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cálculo de Média do Estudante</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">
    <div class="container mt-5">

        
        <form id="mediaForm" method="POST" action="/calcular" class="bg-white p-4 rounded shadow-sm w-25 mx-auto border border-success">

            <h3 class="text-center mb-4">Cálculo de Média</h3>

            <div class="mb-3">
                <label class="form-label">Nome do Aluno:</label>
                <input type="text" class="form-control" name="nome" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Matéria:</label>
                <input type="text" class="form-control" name="materia" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Nota 1:</label>
                <input type="number" class="form-control" name="nota1" min="0" max="10" step="0.1" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Nota 2:</label>
                <input type="number" class="form-control" name="nota2" min="0" max="10" step="0.1" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Nota 3:</label>
                <input type="number" class="form-control" name="nota3" min="0" max="10" step="0.1" required>
            </div>

            <button type="submit" class="btn btn-success w-100">Calcular</button>
        </form>

        <div class="alert alert-success mt-4 w-50 mx-auto text-center">
            <% if (nome !=='' ) { %>
                O aluno <strong>
                    <%= nome %>
                </strong> ficou com a média <strong>
                    <%= media %>
                </strong> na disciplina de <strong>
                    <%= materia %>
                </strong>.
                <% } %>
        </div>
    </div>

</body>

</html>