<%- include('outros/partials/topo', { categorias, titulo: 'Carrinho – Sebo Entrelinhas' }) %>

  <main>

    <!-- DESTAQUES -->
    <section id="destaques" class="destaques py-5">
      <div class="container">
        <h2 class="titulo-secao mb-4">Destaques</h2>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3">
          <% livros.forEach(function(livro) { if (livro.destaque===1) { %>
            <div class="col">
              <a href="/livro/<%= livro.id %>" class="text-decoration-none text-dark">
                <article class="card card-destaque h-100">
                  <span class="selo-destaque">Destaque</span>
                  <div class="row g-0 h-100">
                    <div class="col-5">
                      <img src="/uploads/<%= livro.imagem%>" class="w-100 h-100 rounded-start" alt="Capa de <%= livro.titulo %>">
                    </div>
                    <div class="col-7">
                      <div class="card-body p-2 d-flex flex-column h-100">
                        <h3 class="titulo-destaque">
                          <%= livro.titulo %>
                        </h3>
                        <p class="mb-0 small fw-semibold">
                          <%= livro.autor %>
                        </p>
                        <p class="text-secondary editora-destaque">
                          <%= livro.editora %>
                        </p>
                        <div class="mt-auto">
                          <p class="preco-destaque mb-1">R$ <%= livro.valor.toFixed(2) %></p>
                          <button class="btn btn-ocre btn-sm w-100">
                            <i class="bi bi-cart-plus me-1"></i>Adicionar
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                </article>
              </a>
            </div>
            <% } }); %>
        </div>
      </div>
    </section>

    <!-- CATEGORIA: DRAMA -->
    <section id="Drama" class="py-5">
      <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
          <h2 class="titulo-secao m-0">Drama</h2>
          <a href="/livros-categoria" class="link-secao">Ver todos</a>
        </div>
        <div class="row row-cols-2 row-cols-sm-3 row-cols-lg-6 g-3">
          <% livros.forEach(function(livro) { if (livro.categoria==='Drama' ) { %>
            <div class="col">
              <div class="card card-livro h-100">
                <img src="/uploads/<%= livro.imagem %>" class="card-img-top" alt="Capa de <%= livro.titulo %>">
                <div class="card-body p-2">
                  <h3 class="titulo-livro">
                    <%= livro.titulo %>
                  </h3>
                  <p class="autor mb-0">
                    <%= livro.autor %>
                  </p>
                  <p class="editora mb-0">
                    <%= livro.editora %>
                  </p>
                </div>
                <div class="card-footer bg-white border-0 p-2 d-flex justify-content-between align-items-center">
                  <span class="preco">R$ <%= livro.valor.toFixed(2) %></span>
                  <button class="btn btn-sebo btn-sm" aria-label="Adicionar <%= livro.titulo %> ao carrinho"><i
                      class="bi bi-cart-plus"></i></button>
                </div>
              </div>
            </div>
            <% }}); %>
        </div>
      </div>
    </section>

    <!-- CATEGORIA: FICÇÃO CIENTÍFICA -->
    <section id="ficcao-cientifica" class="py-5 bg-white">
      <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
          <h2 class="titulo-secao m-0">Ficção científica</h2>
          <a href="categoria.html?genero=ficcao-cientifica" class="link-secao">Ver todos</a>
        </div>
        <div class="row row-cols-2 row-cols-sm-3 row-cols-lg-6 g-3">
          <% livros.forEach(function(livro) { if (livro.categoria==='Ficção' ) { %>
            <div class="col">
              <div class="card card-livro h-100">
                <img src="/uploads/<%= livro.imagem %>" class="card-img-top" alt="Capa de <%= livro.titulo %>">
                <div class="card-body p-2">
                  <h3 class="titulo-livro">
                    <%= livro.titulo %>
                  </h3>
                  <p class="autor mb-0">
                    <%= livro.autor %>
                  </p>
                  <p class="editora mb-0">
                    <%= livro.editora %>
                  </p>
                </div>
                <div class="card-footer bg-white border-0 p-2 d-flex justify-content-between align-items-center">
                  <span class="preco">R$ <%= livro.valor.toFixed(2) %></span>
                  <button class="btn btn-sebo btn-sm" aria-label="Adicionar <%= livro.titulo %> ao carrinho"><i
                      class="bi bi-cart-plus"></i></button>
                </div>
              </div>
            </div>
            <% } }); %>
        </div>
      </div>
    </section>

    <!-- CATEGORIA: ROMANCE -->
    <section id="romance" class="py-5">
      <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
          <h2 class="titulo-secao m-0">Romance</h2>
          <a href="categoria.html?genero=romance" class="link-secao">Ver todos</a>
        </div>
        <div class="row row-cols-2 row-cols-sm-3 row-cols-lg-6 g-3">
          <% livros.forEach(function(livro) { if (livro.categoria==='Romance' ) { %>
            <div class="col">
              <div class="card card-livro h-100">
                <a href="/livro/<%=livro.id%>" class="text-decoration-none text-dark">
                  <img src="/uploads/<%= livro.imagem %>" class="card-img-top" alt="Capa de <%= livro.titulo %>">
                </a>
                <div class="card-body p-2">
                  <h3 class="titulo-livro">
                    <%= livro.titulo %>
                  </h3>
                  <p class="autor mb-0">
                    <%= livro.autor %>
                  </p>
                  <p class="editora mb-0">
                    <%= livro.editora %>
                  </p>
                </div>
                <div class="card-footer bg-white border-0 p-2 d-flex justify-content-between align-items-center">
                  <span class="preco">R$ <%= livro.valor.toFixed(2) %></span>
                  <button class="btn btn-sebo btn-sm"
                    aria-label="Adicionar <%= encodeURIComponent(livro.titulo) %> ao carrinho"><i
                      class="bi bi-cart-plus"></i></button>
                </div>
              </div>
            </div>
            <% } }); %>
        </div>
      </div>
    </section>

  </main>
<%- include('outros/partials/rodape') %>