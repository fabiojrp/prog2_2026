<%- include('../partials/header') %>
<%- include('../partials/menu') %>

<main class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between">
                <h4 class="mb-0">
                    <i class="bi bi-box-seam"></i>
                    Produtos
                </h4>
                <a href="/admin/produtos/cadastrar" class="btn btn-light btn-sm">
                    <i class="bi bi-plus-circle"></i>
                    Novo produto
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Livro</th>
                            <th>Destaque</th>
                            <th>Categoria</th>
                            <th>Autor</th>
                            <th>Editora</th>
                            <th>Ano</th>
                            <th>Valor</th>
                            <th>Imagem</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% produtos.forEach(produto => { %>
                            <tr>
                                <td><%= produto.titulo %></td>
                                <td>
                                    <% if (produto.destaque === 1) { %>
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                    <% } else { %>
                                        <i class="bi bi-x-circle-fill text-danger"></i>
                                    <% } %>
                                </td>
                                <td><%= produto.categoria %></td>
                                <td><%= produto.autor %></td>
                                <td><%= produto.editora %></td>
                                <td><%= produto.ano %></td>
                                <td>
                                    R$
                                    <%= Number(produto.valor)
                                        .toFixed(2)
                                        .replace('.', ',') %>
                                </td>                        
                                <td>
                                    <a href="/uploads/<%= produto.imagem %>" 
                                        onclick="window.open( this.href, 'imagem', 'width=200,height=200,resizable=no' ); return false;"
                                        target="_blank">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                                <td>
                                    <button class="btn btn-warning btn-sm">
                                        <i class="bi bi-pencil"></i>
                                        Editar
                                    </button>
                                    <a href="/admin/produtos/excluir/<%= produto.id %>" class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i>
                                        Excluir
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</main>

<%- include('../partials/footer') %>
