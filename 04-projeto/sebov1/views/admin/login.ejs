<%- include('partials/header') %>

    <main class="container py-5 m-auto d-flex flex-column align-items-center justify-content-center flex-grow-1">

        <div class="bg-white p-5 rounded shadow-lg w-50">

            <h4 class="display-6">
                <i class="bi bi-shop"></i>
                Login - Admin E-commerce
            </h4>

            <hr>

            <form action="/admin/login" method="POST">
                <div class="row">

                    <div class="col-md-12">

                        <div class="mb-3">
                            <label for="email" class="form-label">E-mail</label>
                            <input type="email" class="form-control" id="email" name="email" required>
                        </div>

                        <div class="mb-3">
                            <label for="senha" class="form-label">Senha</label>
                            <input type="password" class="form-control" id="senha" name="senha" required>
                        </div>

                        <button type="submit" class="btn btn-secondary mt-3 w-100">Entrar</button>

                    </div>

                </div>
            </form>
        </div>
    </main>

    <%- include('partials/footer') %>