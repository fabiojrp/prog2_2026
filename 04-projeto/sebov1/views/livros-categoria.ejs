  <style>
    /* CSS puro: apenas cores e o básico. O resto é Bootstrap. */
    :root {
      --sebo-verde: #1F4E4A;
      --sebo-verde-escuro: #163836;
      --sebo-ocre: #D9A441;
      --sebo-fundo: #F4F6F3;
      --sebo-texto: #23302F;
    }
    body { background: var(--sebo-fundo); color: var(--sebo-texto); }
    h1, h2, h3, h4, h5, .navbar-brand { font-family: "Libre Baskerville", Georgia, serif; }

    .navbar-sebo { background: var(--sebo-verde); }
    .navbar-sebo .nav-link, .navbar-sebo .navbar-brand { color: #fff; }
    .navbar-sebo .nav-link:hover { color: var(--sebo-ocre); }
    .navbar-sebo .badge-carrinho { background: var(--sebo-ocre); color: var(--sebo-verde-escuro); }

    .titulo-secao { border-bottom: 3px solid var(--sebo-ocre); display: inline-block; padding-bottom: .25rem; }
    .link-secao { color: var(--sebo-verde); font-weight: 600; text-decoration: none; }
    .link-secao:hover { color: var(--sebo-verde-escuro); text-decoration: underline; }

    /* Cards compactos das categorias */
    .card-livro { border: 0; box-shadow: 0 1px 4px rgba(0, 0, 0, .12); }
    .card-livro img { aspect-ratio: 2 / 3; object-fit: cover; }
    .titulo-livro { font-size: .85rem; line-height: 1.25; margin-bottom: .25rem; }
    .card-livro .autor { color: #5b6b69; font-size: .78rem; }
    .card-livro .editora { color: #7a8987; font-size: .72rem; }
    .preco { color: var(--sebo-verde); font-weight: 700; font-size: .95rem; }

    .btn-sebo { background: var(--sebo-verde); color: #fff; border: 0; }
    .btn-sebo:hover { background: var(--sebo-verde-escuro); color: #fff; }
    .btn-ocre { background: var(--sebo-ocre); color: var(--sebo-verde-escuro); border: 0; font-weight: 600; }
    .btn-ocre:hover { background: #c4912f; color: var(--sebo-verde-escuro); }

    /* Destaques: fundo verde e cards horizontais */
    .destaques { background: #FBF3DF; border-top: 4px solid var(--sebo-ocre); border-bottom: 4px solid var(--sebo-ocre); }
    .destaques .titulo-secao { border-color: var(--sebo-ocre); }
    .card-destaque { border: 1px solid #ecd9a8; border-radius: .5rem; background: #fff; position: relative; overflow: hidden; }
    .card-destaque img { object-fit: cover; min-height: 130px; }
    .selo-destaque { position: absolute; top: .75rem; right: 0; background: var(--sebo-ocre); color: var(--sebo-verde-escuro);
                      font-size: .65rem; font-weight: 700; padding: .1rem .5rem; border-radius: .25rem 0 0 .25rem; }
    .titulo-destaque { font-size: .9rem; line-height: 1.25; margin: 1rem 0 .25rem; }
    .editora-destaque { font-size: .75rem; margin-bottom: .5rem; }
    .preco-destaque { color: var(--sebo-verde); font-weight: 700; font-size: 1.05rem; }

    footer { background: var(--sebo-verde-escuro); color: #cfdad8; }

    /* Página de categoria */
    .navbar-sebo .nav-link.active { color: var(--sebo-ocre); font-weight: 600; }
    .breadcrumb a { color: var(--sebo-verde); text-decoration: none; }
    .breadcrumb a:hover { text-decoration: underline; }
    .link-livro { color: inherit; text-decoration: none; }
    .link-livro:hover { color: var(--sebo-verde); text-decoration: underline; }
  </style>
