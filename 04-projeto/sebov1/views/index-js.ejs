<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sebo Entrelinhas – Livros usados</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet">
  <link href="css/estilo-site.css" rel="stylesheet">
</head>
<body>

  <!-- TOPO -->
  <nav class="navbar navbar-expand-lg navbar-sebo sticky-top">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2" href="index.html">
        <!-- Logo provisória (SVG): livro aberto -->
        <svg width="34" height="34" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <path d="M16 8c-3-2.5-7-3-11-2v18c4-1 8-.5 11 2 3-2.5 7-3 11-2V6c-4-1-8-.5-11 2Z" stroke="#D9A441" stroke-width="2" stroke-linejoin="round"/>
          <path d="M16 8v18" stroke="#D9A441" stroke-width="2"/>
        </svg>
        Sebo Entrelinhas
      </a>

      <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#menu" aria-controls="menu" aria-expanded="false" aria-label="Abrir menu">
        <i class="bi bi-list text-white fs-2"></i>
      </button>

      <div class="collapse navbar-collapse" id="menu">
        <ul class="navbar-nav me-auto ms-lg-4">
          <% 
            categorias.forEach(categoria => {
          %>              
              <li class="nav-item"><a class="nav-link" href="#<%= categoria.nome %>"><%= categoria.nome %></a></li>
          <%
            });  
          %>  
        </ul>

        <div class="d-flex align-items-center gap-3">
          <a class="nav-link position-relative" href="carrinho.html" aria-label="Carrinho de compras">
            <i class="bi bi-cart3 fs-4"></i>
            <span class="badge rounded-pill badge-carrinho position-absolute top-0 start-100 translate-middle">0</span>
          </a>
          <a class="nav-link" href="login.html" aria-label="Entrar">
            <i class="bi bi-person-circle fs-4"></i>
          </a>
        </div>
      </div>
    </div>
  </nav>

  <main>

    <!-- DESTAQUES -->
    <section id="destaques" class="destaques py-5">
      <div class="container">
        <h2 class="titulo-secao mb-4">Destaques</h2>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3">
          <%
            livros.forEach(function(livro) {
              if (livro.destaque === 1) {
          %>
          <div class="col">
            <article class="card card-destaque h-100">
              <span class="selo-destaque">Destaque</span>
              <div class="row g-0 h-100">
                <div class="col-5">
                  <img src="/uploads/<%= livro.imagem%>" class="w-100 h-100 rounded-start" alt="Capa de <%= livro.titulo %>">
                </div>
                <div class="col-7">
                  <div class="card-body p-2 d-flex flex-column h-100">
                    <h3 class="titulo-destaque"><%= livro.titulo %></h3>
                    <p class="mb-0 small fw-semibold"><%= livro.autor %></p>
                    <p class="text-secondary editora-destaque"><%= livro.editora %></p>
                    <div class="mt-auto">
                      <p class="preco-destaque mb-1">R$ <%= livro.valor.toFixed(2) %></p>
                      <button class="btn btn-ocre btn-sm w-100"><i class="bi bi-cart-plus me-1"></i>Adicionar</button>
                    </div>
                  </div>
                </div>
              </div>
            </article>
          </div>
          <%
              }
            });
          %>
        </div>
      </div>
    </section>

    <!-- CATEGORIA: DRAMA -->
    <section id="drama" class="py-5">
      <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
          <h2 class="titulo-secao m-0">Drama</h2>
          <a href="categoria.html?genero=drama" class="link-secao">Ver todos</a>
        </div>
        <div class="row row-cols-2 row-cols-sm-3 row-cols-lg-6 g-3">
        <%
        livros.forEach(function(livro) {
          if (livro.categoria === 'Drama') {                  
        %>
          <div class="col">
            <div class="card card-livro h-100">
              <img src="/uploads/<%= livro.imagem %>" class="card-img-top" alt="Capa de <%= livro.titulo %>">
              <div class="card-body p-2">
                <h3 class="titulo-livro"><%= livro.titulo %></h3>
                <p class="autor mb-0"><%= livro.autor %></p>
                <p class="editora mb-0"><%= livro.editora %></p>
              </div>
              <div class="card-footer bg-white border-0 p-2 d-flex justify-content-between align-items-center">
                <span class="preco">R$ <%= livro.valor.toFixed(2) %></span>
                <button class="btn btn-sebo btn-sm" aria-label="Adicionar <%= livro.titulo %> ao carrinho"><i class="bi bi-cart-plus"></i></button>
              </div>
            </div>
            </div>
            <%
          }});
          %>
        </div>
      </div>
    </section>

    <!-- CATEGORIA: FICÇÃO CIENTÍFICA -->
    <section id="ficcao-cientifica" class="py-5 bg-white">
      <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
          <h2 class="titulo-secao m-0">Ficção científica</h2>
          <a href="categoria.html?genero=ficcao-cientifica" class="link-secao">Ver todos</a>
        </div>
        <div class="row row-cols-2 row-cols-sm-3 row-cols-lg-6 g-3">
          <%
            livros.forEach(function(livro) {
              if (livro.categoria === 'Ficção') {
          %>
          <div class="col">
            <div class="card card-livro h-100">
              <img src="/uploads/<%= livro.imagem %>" class="card-img-top" alt="Capa de <%= livro.titulo %>">
              <div class="card-body p-2">
                <h3 class="titulo-livro"><%= livro.titulo %></h3>
                <p class="autor mb-0"><%= livro.autor %></p>
                <p class="editora mb-0"><%= livro.editora %></p>
              </div>
              <div class="card-footer bg-white border-0 p-2 d-flex justify-content-between align-items-center">
                <span class="preco">R$ <%= livro.valor.toFixed(2) %></span>
                <button class="btn btn-sebo btn-sm" aria-label="Adicionar <%= livro.titulo %> ao carrinho"><i class="bi bi-cart-plus"></i></button>
              </div>
            </div>
          </div>
          <%
              }
            });
          %>        
        </div>
      </div>
    </section>

    <!-- CATEGORIA: ROMANCE -->
    <section id="romance" class="py-5">
      <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
          <h2 class="titulo-secao m-0">Romance</h2>
          <a href="categoria.html?genero=romance" class="link-secao">Ver todos</a>
        </div>
        <div class="row row-cols-2 row-cols-sm-3 row-cols-lg-6 g-3">
          <%
            livros.forEach(function(livro) {
              if (livro.categoria === 'Romance') {
          %>
          <div class="col">
            <div class="card card-livro h-100">
              <img src="/uploads/<%= livro.imagem %>" class="card-img-top" alt="Capa de <%= livro.titulo %>">
              <div class="card-body p-2">
                <h3 class="titulo-livro"><%= livro.titulo %></h3>
                <p class="autor mb-0"><%= livro.autor %></p>
                <p class="editora mb-0"><%= livro.editora %></p>
              </div>
              <div class="card-footer bg-white border-0 p-2 d-flex justify-content-between align-items-center">
                <span class="preco">R$ <%= livro.valor.toFixed(2) %></span>
                <button class="btn btn-sebo btn-sm" aria-label="Adicionar <%= encodeURIComponent(livro.titulo) %> ao carrinho"><i class="bi bi-cart-plus"></i></button>
              </div>
            </div>
          </div>
          <%
              }
            });
          %>          
        </div>
      </div>
    </section>

  </main>

  <!-- RODAPÉ -->
  <footer class="py-4">
    <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
      <span>&copy; 2026 Sebo Entrelinhas. Livros usados com história.</span>
      <span>contato@seboentrelinhas.com.br</span>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
