<%- include('../admin/partials/header', { categorías }) %>

  <main class="py-5">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">

          <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
              <h1 class="h3 titulo-secao mb-4">Entrar</h1>

              <% if (sucesso) { %>
                <div class="alert alert-success"><i class="bi bi-check-circle me-1"></i>Cadastro realizado! Faça login para continuar.</div>
              <% } %>

              <% if (erro) { %>
                <div class="alert alert-danger"><i class="bi bi-exclamation-circle me-1"></i><%= erro %></div>
              <% } %>

              <form action="/usuario/login" method="POST">
                <div class="mb-3">
                  <label for="email" class="form-label">E-mail</label>
                  <input type="email" class="form-control" id="email" name="email" value="<%= email %>" required>
                </div>

                <div class="mb-4">
                  <label for="senha" class="form-label">Senha</label>
                  <input type="password" class="form-control" id="senha" name="senha" required>
                </div>

                <button type="submit" class="btn btn-sebo btn-lg w-100">Entrar</button>
              </form>

              <hr class="my-4">

              <p class="text-center mb-0">
                Primeiro acesso? <a href="/usuario/cadastro" class="link-secao">Cadastre-se</a>
              </p>
            </div>
          </div>

        </div>
      </div>
    </div>
  </main>

<%- include('../admin/partials/footer') %>
