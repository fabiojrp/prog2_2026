

  <%- include('partials/topo', { menu }) %>

  <main class="pt-4 pb-5">
    <div class="container">

      <!-- Caminho de navegação -->
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/">Início</a></li>
          <li class="breadcrumb-item"><a href="/#<%= slugCategoria %>"><%= livro.categoria %></a></li>
          <li class="breadcrumb-item active" aria-current="page"><%= livro.titulo %></li>
        </ol>
      </nav>

      <article class="row g-4 g-lg-5 py-3">

        <!-- Capa -->
        <div class="col-12 col-md-5 col-lg-4">
          <img src="/uploads/<%= livro.imagem %>" class="capa-detalhe w-100" alt="Capa de <%= livro.titulo %>">
        </div>

        <!-- Informações -->
        <div class="col-12 col-md-7 col-lg-8">
          <span class="selo-categoria"><%= livro.categoria %></span>
          <h1 class="titulo-detalhe mt-2"><%= livro.titulo %></h1>
          <p class="fs-5 mb-4">de <strong><%= livro.autor %></strong></p>

          <!-- Compra -->
          <div class="box-compra mb-4">
            <p class="preco-detalhe mb-1">R$ <%= livro.valor.toFixed(2).replace('.', ',') %></p>
            <p class="small text-secondary mb-3"><i class="bi bi-info-circle me-1"></i>Livro usado</p>
            <div class="d-flex flex-wrap gap-2">
              <button class="btn btn-sebo btn-lg"><i class="bi bi-cart-plus me-2"></i>Adicionar ao carrinho</button>
              <a href="/" class="btn btn-outline-secondary btn-lg">Continuar comprando</a>
            </div>
          </div>

          <!-- Ficha técnica -->
          <h2 class="h5 titulo-secao mb-3">Detalhes</h2>
          <dl class="row ficha mb-4">
            <dt class="col-4 col-sm-3">Autor</dt>
            <dd class="col-8 col-sm-9"><%= livro.autor %></dd>
            <dt class="col-4 col-sm-3">Editora</dt>
            <dd class="col-8 col-sm-9"><%= livro.editora %></dd>
            <dt class="col-4 col-sm-3">Categoria</dt>
            <dd class="col-8 col-sm-9"><%= livro.categoria %></dd>
          </dl>

          <% if (livro.descricao) { %>
            <h2 class="h5 titulo-secao mb-3">Sobre o livro</h2>
            <p><%= livro.descricao %></p>
          <% } %>
        </div>

      </article>
    </div>
  </main>

  <% if (relacionados.length > 0) { %>
  <!-- Mais livros da mesma categoria -->
  <section class="py-5 bg-white">
    <div class="container">
      <h2 class="titulo-secao mb-4">Mais em <%= livro.categoria %></h2>
      <div class="row row-cols-2 row-cols-sm-3 row-cols-lg-6 g-3">
        <% relacionados.forEach(function(outro) { %>
          <%- include('partials/card-livro', { livro: outro }) %>
        <% }); %>
      </div>
    </div>
  </section>
  <% } %>

  <%- include('partials/rodape') %>